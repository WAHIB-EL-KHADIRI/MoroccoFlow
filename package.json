{
  "name": "moroccoflow",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "A local-first Moroccan business management portfolio by WAHIB EL KHADIRI.",
  "author": "WAHIB EL KHADIRI",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "check": "npm run lint && npm run test && npm run api:test && npm run build",
    "screenshots": "node scripts/capture-screenshots.mjs",
    "api:dev": "npm run dev --workspace @moroccoflow/api",
    "api:start": "npm run start --workspace @moroccoflow/api",
    "api:test": "npm run test --workspace @moroccoflow/api",
    "db:migrate": "npm run migrate --workspace @moroccoflow/api",
    "db:backup": "node --env-file-if-exists=.env scripts/backup-postgres.mjs"
  },
  "dependencies": {
    "chart.js": "4.5.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.12.1",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.61.1",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "10.7.0",
    "fake-indexeddb": "6.2.5",
    "globals": "17.7.0",
    "jsdom": "29.1.1",
    "prettier": "3.9.5",
    "vite": "8.1.5",
    "vitest": "4.1.10"
  },
  "engines": {
    "node": ">=22.12"
  },
  "workspaces": [
    "backend"
  ]
}
